{
  "name": "tavrn-bot-platform",
  "version": "0.1.0",
  "private": true,
  "description": "A complete example bot for tavrn with a web dashboard, for any number of rooms",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=2",
    "e2e": "playwright test -c e2e/playwright.config.ts --project chromium --project mobile-android --workers=2",
    "check": "bash scripts/ci-changes.test.sh && scripts/check-spdx.sh && node scripts/check-js-licenses.mjs && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@tavrn/bot": "github:just-tavrn/tavrn-js#ce905e164328c30bb69a5a1632367796a000d375&path:bot",
    "@tavrn/sdk": "github:just-tavrn/tavrn-js#ce905e164328c30bb69a5a1632367796a000d375&path:sdk",
    "hono": "^4.13.14",
    "nodemailer": "^10.2.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^24.19.1",
    "@types/nodemailer": "^8.0.2",
    "happy-dom": "^21.0.4",
    "preact": "^10.29.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
