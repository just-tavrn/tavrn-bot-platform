{
  "name": "tavrn-bot-platform",
  "version": "0.1.0",
  "private": true,
  "description": "A complete example bot for tavrn with a web dashboard, for any number of rooms",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=2",
    "e2e": "playwright test -c e2e/playwright.config.ts --project chromium --project mobile-android --workers=2",
    "check": "scripts/check-spdx.sh && node scripts/check-js-licenses.mjs && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@tavrn/bot": "^0.2.1",
    "@tavrn/sdk": "^0.2.1",
    "hono": "^4.13.13",
    "nodemailer": "^10.1.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "happy-dom": "^21.0.3",
    "preact": "^11.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
